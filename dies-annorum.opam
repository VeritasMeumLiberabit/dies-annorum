# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "Dies Annorum - A OCaml library for determining what liturgical celebrations are on a particular date in the Roman Rite."
description: """
This library takes a date and a location and lets you know what liturgical celebrations
               occur on that date in the reformed calendar of the Roman Rite. The primary use case
               as of now is for the offices of the Liturgy of the Hours. It may in future be expanded
               to cover other liturgical celebrations."""
maintainer: ["Jonathan Lowe <me@jonathanlowe.dev>"]
authors: ["Jonathan Lowe <me@jonathanlowe.dev>"]
license: "GPL-3.0"
tags: ["calendar" "liturgical" "roman-rite"]
homepage: "https://github.com/VeritasMeumLiberabit/dies-annorum"
doc: "https://url/to/documentation"
bug-reports: "https://github.com/VeritasMeumLiberabit/dies-annorum/issues"
depends: [
  "dune" {>= "3.24"}
  "ocaml" {>= "5.0"}
  "calendar"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/VeritasMeumLiberabit/dies-annorum.git"
x-maintenance-intent: ["(latest)"]
